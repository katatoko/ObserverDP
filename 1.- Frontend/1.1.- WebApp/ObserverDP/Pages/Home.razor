@page "/"
@using Domain
@using Entities
@using DTOs
@using Weather.Services

@* Inyectamos el Sujeto (Estación) y los 3 Observadores registrados en Program.cs *@
@inject WeatherStationService Station
@inject CurrentConditionsObserver ObsCondiciones
@inject StatisticsObserver ObsEstadisticas
@inject ForecastObserver ObsPronostico

<PageTitle>Patrón Observer - Estación Meteorológica</PageTitle>

<div class="dashboard-container">
    <header class="header-banner">
        <div>
            <h1>🌦️ Estación Meteorológica IoT — Patrón Observer (GoF)</h1>
            <p>Demostración interactiva de bajo acoplamiento, suscripción dinámica (Attach/Detach) y enfoques <strong>PUSH vs. PULL</strong></p>
        </div>
        <div class="badge-counter">
            Observadores Conectados: <strong>@Station.ObservadoresConectados / 3</strong>
        </div>
    </header>

    @* ===================================================================== *@
    @* PANEL DEL SUJETO (WeatherStationService)                              *@
    @* ===================================================================== *@
    <section class="subject-panel">
        <div class="panel-header">
            <h2>📡 SUJETO (Observable): <code>WeatherStationService</code></h2>
            <span class="timestamp">Última emisión: @Station.LecturaActual.RecordedAt.ToString("HH:mm:ss")</span>
        </div>

        <div class="sliders-grid">
            <div class="slider-box">
                <label>🌡️ Temperatura: <strong>@tempInput.ToString("0.0") °C</strong></label>
                <input type="range" min="-5" max="45" step="0.5" @bind="tempInput" @bind:event="oninput" />
            </div>

            <div class="slider-box">
                <label>💧 Humedad: <strong>@humedadInput.ToString("0") %</strong></label>
                <input type="range" min="10" max="100" step="1" @bind="humedadInput" @bind:event="oninput" />
            </div>

            <div class="slider-box">
                <label>🧭 Presión Atmosférica: <strong>@presionInput.ToString("0") hPa</strong></label>
                <input type="range" min="980" max="1040" step="1" @bind="presionInput" @bind:event="oninput" />
            </div>
        </div>

        <div class="actions-bar">
            <button class="btn-primary" @onclick="EnviarMediciones">
                📢 Actualizar Estación y Notificar (Notify)
            </button>
            <button class="btn-secondary" @onclick="SimularClimaAleatorio">
                🎲 Simular Clima Aleatorio
            </button>
        </div>
    </section>

    @* ===================================================================== *@
    @* TARJETAS DE LOS 3 OBSERVADORES CONCRETOS                              *@
    @* ===================================================================== *@
    <section class="observers-grid">

        @* OBSERVADOR 1: CONDICIONES ACTUALES (PUSH) *@
        <div class="observer-card @(obs1Conectado ? "connected" : "disconnected")">
            <div class="card-top">
                <span class="tag-push">ENFOQUE PUSH</span>
                <span class="status-pill @(obs1Conectado ? "on" : "off")">
                    @(obs1Conectado ? "🟢 Suscrito" : "🔴 Desuscrito")
                </span>
            </div>
            <h3>🌡️ 1. Condiciones Actuales</h3>
            <p class="class-name"><code>CurrentConditionsObserver</code></p>
            <p class="desc">Recibe el objeto <code>WeatherReading</code> completo por el parámetro de <code>Update(reading)</code>.</p>

            <div class="metrics-list">
                <div class="metric-item">
                    <span>Temperatura:</span>
                    <strong>@ObsCondiciones.UltimaLectura.TemperaturaCelsius °C</strong>
                </div>
                <div class="metric-item">
                    <span>Humedad:</span>
                    <strong>@ObsCondiciones.UltimaLectura.PorcentajeHumedad %</strong>
                </div>
                <div class="metric-item">
                    <span>Presión:</span>
                    <strong>@ObsCondiciones.UltimaLectura.PresionHpa hPa</strong>
                </div>
                <div class="metric-item">
                    <span>Hora recibida:</span>
                    <strong>@ObsCondiciones.UltimaLectura.RecordedAt.ToString("HH:mm:ss")</strong>
                </div>
            </div>

            <div class="card-footer">
                <span class="updates-count">Notificaciones recibidas: <strong>@ObsCondiciones.ActualizacionesRecibidas</strong></span>
                <button class="btn-toggle @(obs1Conectado ? "btn-detach" : "btn-attach")" @onclick="ToggleObservador1">
                    @(obs1Conectado ? "Desconectar (Detach)" : "Conectar (Attach)")
                </button>
            </div>
        </div>

        @* OBSERVADOR 2: ESTADÍSTICAS (PUSH + DTO) *@
        <div class="observer-card @(obs2Conectado ? "connected" : "disconnected")">
            <div class="card-top">
                <span class="tag-push">ENFOQUE PUSH + DTO</span>
                <span class="status-pill @(obs2Conectado ? "on" : "off")">
                    @(obs2Conectado ? "🟢 Suscrito" : "🔴 Desuscrito")
                </span>
            </div>
            <h3>📊 2. Estadísticas de Temperatura</h3>
            <p class="class-name"><code>StatisticsObserver</code></p>
            <p class="desc">Acumula el historial de temperaturas empujadas y calcula un <code>WeatherStatisticsDto</code>.</p>

            <div class="metrics-list">
                <div class="metric-item">
                    <span>Promedio:</span>
                    <strong>@ObsEstadisticas.Estadisticas.TemperaturaPromedio °C</strong>
                </div>
                <div class="metric-item">
                    <span>Máxima registrada:</span>
                    <strong class="text-danger">@ObsEstadisticas.Estadisticas.TemperaturaMaxima °C</strong>
                </div>
                <div class="metric-item">
                    <span>Mínima registrada:</span>
                    <strong class="text-info">@ObsEstadisticas.Estadisticas.TemperaturaMinima °C</strong>
                </div>
                <div class="metric-item">
                    <span>Lecturas en historial:</span>
                    <strong>@ObsEstadisticas.Estadisticas.LecturasTotales</strong>
                </div>
            </div>

            <div class="card-footer">
                <span class="updates-count">Total procesadas: <strong>@ObsEstadisticas.Estadisticas.LecturasTotales</strong></span>
                <button class="btn-toggle @(obs2Conectado ? "btn-detach" : "btn-attach")" @onclick="ToggleObservador2">
                    @(obs2Conectado ? "Desconectar (Detach)" : "Conectar (Attach)")
                </button>
            </div>
        </div>

        @* OBSERVADOR 3: PRONÓSTICO BAROMÉTRICO (PULL) *@
        <div class="observer-card @(obs3Conectado ? "connected" : "disconnected")">
            <div class="card-top">
                <span class="tag-pull">ENFOQUE PULL</span>
                <span class="status-pill @(obs3Conectado ? "on" : "off")">
                    @(obs3Conectado ? "🟢 Suscrito" : "🔴 Desuscrito")
                </span>
            </div>
            <h3>🧭 3. Pronóstico Barométrico</h3>
            <p class="class-name"><code>ForecastObserver</code></p>
            <p class="desc">Ignora el parámetro y consulta al sujeto (<code>station.LecturaActual.PresionHpa</code>) solo el dato que necesita.</p>

            <div class="forecast-box">
                @ObsPronostico.MensajePronostico
            </div>

            <div class="metrics-list">
                <div class="metric-item">
                    <span>Presión Previa:</span>
                    <strong>@ObsPronostico.PresionPrevia hPa</strong>
                </div>
                <div class="metric-item">
                    <span>Presión Actual (PULL):</span>
                    <strong>@ObsPronostico.PresionActual hPa</strong>
                </div>
            </div>

            <div class="card-footer">
                <span class="updates-count">Notificaciones recibidas: <strong>@ObsPronostico.ActualizacionesRecibidas</strong></span>
                <button class="btn-toggle @(obs3Conectado ? "btn-detach" : "btn-attach")" @onclick="ToggleObservador3">
                    @(obs3Conectado ? "Desconectar (Detach)" : "Conectar (Attach)")
                </button>
            </div>
        </div>

    </section>
</div>

