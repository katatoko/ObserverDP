@code {
    // Valores actuales de los sliders en pantalla
    private double tempInput = 24.0;
    private double humedadInput = 60.0;
    private double presionInput = 1013.0;

    // Bandera visual para saber si cada observador está conectado o desconectado
    private bool obs1Conectado = true;
    private bool obs2Conectado = true;
    private bool obs3Conectado = true;

    // Se ejecuta automáticamente una vez al abrir la página
    protected override void OnInitialized()
    {
        // Suscribimos inicialmente los 3 observadores al Sujeto (Estación)
        Station.Attach(ObsCondiciones);
        Station.Attach(ObsEstadisticas);
        Station.Attach(ObsPronostico);

        // Enviamos una primera lectura inicial si aún no han recibido ninguna
        if (ObsCondiciones.ActualizacionesRecibidas == 0)
        {
            Station.SetMeasurements(tempInput, humedadInput, presionInput);
        }
    }

    // Envía los valores de los sliders a la estación (dispara Notify() por dentro)
    private void EnviarMediciones()
    {
        Station.SetMeasurements(tempInput, humedadInput, presionInput);
    }

    // Genera valores aleatorios para probar rápidamente en la exposición
    private void SimularClimaAleatorio()
    {
        var random = new Random();
        tempInput = Math.Round(15 + random.NextDouble() * 20, 1);
        humedadInput = random.Next(30, 95);
        presionInput = random.Next(990, 1030);

        Station.SetMeasurements(tempInput, humedadInput, presionInput);
    }

    // Conecta (Attach) o Desconecta (Detach) el Observador 1 en tiempo de ejecución
    private void ToggleObservador1()
    {
        if (obs1Conectado)
            Station.Detach(ObsCondiciones);
        else
            Station.Attach(ObsCondiciones);

        obs1Conectado = !obs1Conectado;
    }

    // Conecta (Attach) o Desconecta (Detach) el Observador 2 en tiempo de ejecución
    private void ToggleObservador2()
    {
        if (obs2Conectado)
            Station.Detach(ObsEstadisticas);
        else
            Station.Attach(ObsEstadisticas);

        obs2Conectado = !obs2Conectado;
    }

    // Conecta (Attach) o Desconecta (Detach) el Observador 3 en tiempo de ejecución
    private void ToggleObservador3()
    {
        if (obs3Conectado)
            Station.Detach(ObsPronostico);
        else
            Station.Attach(ObsPronostico);

        obs3Conectado = !obs3Conectado;
    }
}